# Copy to deploy/.env on the server and fill in. Never commit the real .env.

# The site address, e.g. app.alkara.sa (its DNS A record must point at this server)
DOMAIN=app.example.com

# Generate each with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=

# A NEW OurSms token (the old one is in git history and must be revoked)
OURSMS_TOKEN=

# Only used on the very first start, when the database is empty
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Daily backup (deploy/backup.sh)
# rclone remote and folder for the off-server copy, e.g. storagebox:alkara
BACKUP_REMOTE=
# Days to keep backups on the server and off the server
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30
