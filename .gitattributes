# Normalize all text files to LF in the repo and in the working tree
* text=auto eol=lf

# Binary files: never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
